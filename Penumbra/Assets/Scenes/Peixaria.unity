  vozAlice: {fileID: 8300000, guid: 0edf421f225543e47a748e88ecdc250a, type: 3}
  vozNPC: {fileID: 8300000, guid: 9dab6a15a90fa04459d3d9b035fb5a73, type: 3}
  volumeVoz: 1
  painelPuzzlePeixes: {fileID: 106301927}
  indicadorInteracao: {fileID: 1697331666}
  nomeDoPersonagem: Pescador
  nomeProtagonista: Alice
