  nomeDoPersonagem: Pastor
  nomeProtagonista: Alice
  pastorOpcional: 1
  gerenciadorPensamentos: {fileID: 1846865664}
  pensamentoPastor1: "Que cara bizarro... n\xE3o quero falar com ele, ele me d\xE1 uma sensa\xE7\xE3o estranha..."
  pensamentoPastor2: Bom, vamos voltar para o que eu estava fazendo.
  alicePastorPensamento1Fechada: {fileID: 3115233562101966255, guid: 8240cb8f09b1cf545b3f3a77ca7e145f, type: 3}
  alicePastorPensamento1Aberta: {fileID: 3115233562101966255, guid: 8240cb8f09b1cf545b3f3a77ca7e145f, type: 3}
  alicePastorPensamento2Fechada: {fileID: -6968551063855250685, guid: 9c5b06353e4f8294db5cc0299fca110f, type: 3}
  alicePastorPensamento2Aberta: {fileID: -6968551063855250685, guid: 9c5b06353e4f8294db5cc0299fca110f, type: 3}
